modsecurity_conf=/etc/modsecurity/modsecurity.conf
modsecurity_recommended=/etc/modsecurity/modsecurity.conf-recommended
apache_security_conf=/etc/apache2/mods-available/security2.conf
apache_enabled_conf=/etc/apache2/mods-enabled/security2.conf
custom_exclusions=/etc/modsecurity/modsec-custom-exclusions.conf
audit_log=/var/log/apache2/modsec_audit.log
error_log=/var/log/apache2/error.log
apachectl=/usr/sbin/apachectl
systemctl=/usr/bin/systemctl
a2enmod=/usr/sbin/a2enmod
a2dismod=/usr/sbin/a2dismod
a2enconf=/usr/sbin/a2enconf
a2disconf=/usr/sbin/a2disconf
apt_get=/usr/bin/apt-get
dpkg_query=/usr/bin/dpkg-query
rule_dirs=/etc/modsecurity,/etc/modsecurity/crs,/usr/share/modsecurity-crs,/usr/share/modsecurity-crs/rules
tail_lines=5000
apache_sites_dir=/etc/apache2/sites-enabled
crs_setup=/etc/modsecurity/crs/crs-setup.conf
cron_file=/etc/cron.d/webmin-modsec-manager
alert_enabled=0
alert_interval=15
alert_threshold=50
alert_cooldown=60
ai_bots_enabled=0
